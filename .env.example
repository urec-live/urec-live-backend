SPRING_DATASOURCE_URL=jdbc:postgresql://<host>/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=<db_user>
SPRING_DATASOURCE_PASSWORD=<db_password>
JWT_SECRET=<at-least-32-characters-secret>
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
SPRING_JPA_SHOW_SQL=false
# Optional: GIF and sticker search in chat (https://klipy.com/developers). Leave empty to turn it off.
KLIPY_API_KEY=
# Optional: chat photos. Without these, photos are kept in ~/.urec-live/chat-media on this machine.
# For Cloudflare R2, set MEDIA_STORAGE=s3 and all four MEDIA_S3_* values (see CHAT_PHOTOS_TESTING.md).
MEDIA_STORAGE=local
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
